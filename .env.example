# Server Configuration
PORT=3000
NODE_ENV=production

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://scorpion_admin:YOUR_DB_PASSWORD@localhost:5432/scorpion_ps?schema=public"

# JWT Secret for Authentication
JWT_SECRET="super-secret-scorpion-gaming-jwt-key-change-in-prod"
JWT_EXPIRES_IN="7d"

# Firebase Cloud Messaging (FCM) - Optional until configured
FIREBASE_PROJECT_ID="scorpion-gaming-ps"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@scorpion-gaming-ps.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
