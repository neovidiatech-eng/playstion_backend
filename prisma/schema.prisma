generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  EMPLOYEE
  CUSTOMER
}

enum EmployeeType {
  STANDARD
  CUSTOM
}

enum RoomType {
  INDOOR
  OUTDOOR
}

enum DeviceType {
  PS4
  PS5
}

enum DeviceStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
}

enum BookingMode {
  SINGLE
  MULTIPLAYER
}

enum BookingStatus {
  PENDING
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
  REJECTED
}

enum PaymentMethod {
  CASH_ON_ARRIVAL
  INSTAPAY_WALLET
}

enum NotificationTargetRole {
  ALL
  CUSTOMER
  EMPLOYEE
  ADMIN
}

// ─────────────────────────────────────────────
// Models
// ─────────────────────────────────────────────

model Branch {
  id        String   @id @default(uuid())
  name      String
  address   String?
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  rooms     Room[]
  employees User[]    @relation("EmployeeBranches")
  bookings  Booking[]
  shifts    Shift[]
  offers    Offer[]
}

model Room {
  id        String   @id @default(uuid())
  name      String
  type      RoomType
  notes     String?
  createdAt DateTime @default(now())

  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  devices   Device[]
}

model Device {
  id               String       @id @default(uuid())
  name             String
  type             DeviceType
  status           DeviceStatus @default(AVAILABLE)
  currentBookingId String?
  createdAt        DateTime     @default(now())

  roomId   String
  room     Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)

  bookings Booking[]
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  phone        String?
  fcmToken     String?
  role         UserRole
  employeeType EmployeeType?
  permissions  String[]
  loyaltyPoints Int         @default(0)
  createdAt    DateTime     @default(now())

  createdByAdminId String?

  assignedBranches   Branch[]  @relation("EmployeeBranches")
  bookingsCreated    Booking[] @relation("CreatedByUser")
  bookingsAsCustomer Booking[] @relation("CustomerBookings")
  shifts             Shift[]
}

model Booking {
  id                 String        @id @default(uuid())
  customerNameManual String?
  startTime          DateTime
  endTime            DateTime
  mode               BookingMode
  price              Decimal       @db.Decimal(10, 2)
  discountAmount     Decimal       @default(0) @db.Decimal(10, 2)
  couponCode         String?
  isOpenTime         Boolean       @default(false)
  isOffer            Boolean       @default(false)
  offerNote          String?
  status             BookingStatus @default(PENDING)
  paymentMethod      PaymentMethod @default(CASH_ON_ARRIVAL)
  paymentSender      String?
  receiptImage       String?
  rejectionReason    String?
  createdAt          DateTime      @default(now())

  deviceId   String
  device     Device @relation(fields: [deviceId], references: [id])

  branchId   String
  branch     Branch @relation(fields: [branchId], references: [id])

  customerId String?
  customer   User?   @relation("CustomerBookings", fields: [customerId], references: [id])

  createdByUserId String
  createdBy       User   @relation("CreatedByUser", fields: [createdByUserId], references: [id])

  items      BookingItem[]
}

enum ProductCategory {
  HOT_DRINKS
  COLD_DRINKS
  SNACKS
}

model Product {
  id          String          @id @default(uuid())
  name        String
  category    ProductCategory
  price       Decimal         @db.Decimal(10, 2)
  isAvailable Boolean         @default(true)
  createdAt   DateTime        @default(now())

  bookingItems BookingItem[]
}

model BookingItem {
  id        String   @id @default(uuid())
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  productId String
  product   Product  @relation(fields: [productId], references: [id])
}

model Shift {
  id               String    @id @default(uuid())
  date             DateTime  @default(now())
  startTime        DateTime  @default(now())
  endTime          DateTime?
  totalRevenue     Decimal?  @db.Decimal(10, 2)
  cashCollected    Decimal?  @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime  @default(now())

  employeeId String
  employee   User   @relation(fields: [employeeId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])
}

model Offer {
  id                      String    @id @default(uuid())
  title                   String
  description             String?
  discountPercent         Decimal?  @db.Decimal(5, 2)
  pricePerHourSingle      Decimal?  @db.Decimal(10, 2)
  pricePerHourMultiplayer Decimal?  @db.Decimal(10, 2)
  validFrom               DateTime?
  validTo                 DateTime?
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])
}

model Coupon {
  id              String    @id @default(uuid())
  code            String    @unique
  title           String?
  discountPercent Decimal?  @db.Decimal(5, 2)
  discountAmount  Decimal?  @db.Decimal(10, 2)
  minOrderAmount  Decimal?  @db.Decimal(10, 2)
  maxUses         Int?
  usedCount       Int       @default(0)
  validFrom       DateTime?
  validTo         DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
}

model SystemSettings {
  id                      String   @id @default("default")
  defaultPriceSingle      Decimal  @default(25.0) @db.Decimal(10, 2)
  defaultPriceMultiplayer Decimal  @default(40.0) @db.Decimal(10, 2)
  instapayAddress         String   @default("scorpion@instapay")
  instapayPhone           String   @default("01011111111")
  vodafoneCashPhone       String   @default("01022222222")
  supportWhatsapp         String   @default("201011111111")
  updatedAt               DateTime @updatedAt
}

model Notification {
  id         String                 @id @default(uuid())
  title      String
  body       String
  type       String                 @default("system")
  userId     String?
  targetRole NotificationTargetRole @default(ALL)
  isRead     Boolean                @default(false)
  createdAt  DateTime               @default(now())
}
